# ReconLedger single-VM environment configuration.
# Copy this file to .env:
#   cp deploy/vultr/.env.example deploy/vultr/.env && chmod 600 deploy/vultr/.env
# Never commit real secrets. Keys stay only on the VM.

# Domain for automatic TLS with Caddy.
# A free sslip.io hostname works without buying a domain (e.g. 203-0-113-5.sslip.io).
RECONLEDGER_DOMAIN=

# HTTP Basic Auth credentials (mandatory for non-loopback binds).
# Generate password with: openssl rand -base64 24
WEB_BASIC_AUTH_USER=
WEB_BASIC_AUTH_PASS=

# LLM planner / narrator (Vultr Serverless Inference or mock).
# Leave LLM_PROVIDER empty for fully deterministic rule-based planning.
LLM_PROVIDER=
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=
# LLM_MODEL=qwen3.8-27b
LLM_MODEL=

# Control layer limits
WEB_RATE_LIMIT_PER_MIN=30
WEB_MAX_ACTIVE_ASSESSMENTS=2
