# Control layer container for ReconLedger on Vultr VM.
# Runs the FastAPI web approve/reject UI and orchestrates sandbox containers via Docker CLI.
# No secrets, no ENV with credentials.

FROM docker:27-cli AS docker-cli

FROM python:3.12-slim

# Copy ONLY the docker CLI binary from the official docker:27-cli image
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

WORKDIR /app

ENV DOCKER_CONFIG=/tmp/.docker

# Copy repo files needed to install and run reconledger
COPY pyproject.toml README.md ./
COPY rules/ ./rules/
COPY src/ ./src/

RUN pip install --no-cache-dir -e ".[web]"

# Directory for the persistent ledger volume
RUN mkdir -p /app/out

EXPOSE 8080

CMD ["reconledger", "web", "--host", "0.0.0.0", "--port", "8080"]
