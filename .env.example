# Copy to .env and fill in locally. Never commit real values.
# The control layer reads these; none of them is ever passed into a sandbox.

# LLM planner / narrator: vultr | mock | (empty = deterministic, no LLM)
LLM_PROVIDER=
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=20

# Web control layer. Auth may stay empty only when bound to 127.0.0.1.
WEB_BASIC_AUTH_USER=
WEB_BASIC_AUTH_PASS=
RECONLEDGER_WEB_LEDGER=out/web-ledger.jsonl

# Sandbox overrides (defaults shown). The network must be Docker-internal.
RECONLEDGER_SANDBOX_IMAGE=reconledger-sandbox:latest
RECONLEDGER_SANDBOX_NETWORK=reconledger-lab
